service cloud.firestore {
  match /databases/{database}/documents {

    // Firebase "test mode": open to everyone until the date passes.
    match /drafts/{draftId} {
      allow read, write: if request.time < timestamp.date(2027, 1, 1);
    }

    // Any signed-in user can read and delete everyone's orders.
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // The client sends ownerId, so anyone can claim any existing profile.
    match /profiles/{profileId} {
      allow update: if request.auth.uid == request.resource.data.ownerId;
    }

    // resource is null on create, so nobody can create a post.
    match /posts/{postId} {
      allow create: if resource.data.authorId == request.auth.uid;
    }

    // Leftover catch-all: overrides every rule above.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
